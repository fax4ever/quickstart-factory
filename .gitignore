# macOS
.DS_Store

# Editor
.idea/
.vscode/

# Python
__pycache__/
.venv/
.poetry-cache/

# Local secrets and env
.env
.env.*
*.key
*.pem

# Client-specific tracked files (currently only claude supports the policy hook)
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
.codex/*
!.codex/skills/
.cursor/*
!.cursor/rules/
!.cursor/skills/
.gemini/*
!.gemini/skills/

# Generated output (legacy convention, largely superseded by .rhoai-qs/ below)
data/

# Everything for every quickstart lives here: pipeline state, specs, PRDs,
# designs, blog drafts, reports, AND each quickstart's own code repo (each
# quickstart is its own separate git repo/remote, e.g. rh-ai-quickstart/<slug>,
# set up directly inside .rhoai-qs/<slug>/ by rh-qs-scaffold via git init, not
# git clone, since the folder already has pipeline/prds/designs/ in it before
# scaffold runs). One single rule covers all of it — no per-slug maintenance
# needed here. Note: the quickstart's own repo needs its OWN .gitignore entries
# for pipeline/, prds/, designs/, blog-drafts/, reports/ so those bookkeeping
# folders never get pushed to its public GitHub remote — see
# docs/foundation/pipeline-convention.md.
.rhoai-qs/

# Temporary files
.tmp/
brain.ai
brain.code-workspace